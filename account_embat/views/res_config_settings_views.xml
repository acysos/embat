<odoo>
    <record id="view_account_embat_res_config_settings" model="ir.ui.view">
        <field name="name">res.config.settings.account.embat.form</field>
        <field name="model">res.config.settings</field>
        <field name="inherit_id" ref="account.res_config_settings_view_form"/>
        <field name="arch" type="xml">
            <xpath expr="//div[hasclass('settings')]" position="inside">
                <h2>Embat Accounting</h2>
                <div class="row mt16 o_settings_container" id="embat_accounting">
                    <div class="col-12 col-lg-6 o_setting_box" id="enable_embat_accounting" title="Allows you to use Embat accounting.">
                        <div class="o_setting_left_pane">
                            <field name="use_embat"/>
                        </div>
                        <div class="o_setting_right_pane">
                            <label for="use_embat" string="Use Embat accounting"/>
                            <div class="text-muted">
                                Enable or disable the use of Embat for accounting.
                            </div>
                            <div class="content-group" attrs="{'invisible': [('use_embat', '=', False)]}">
                                <div class="mt16">
                                    <label for="embat_data_id" class="o_light_label"/>
                                    <field name="embat_data_id" placeholder="Embat Data ID" class="oe_inline" attrs="{'required': [('use_embat', '=', True)]}"/>
                                </div>
                                <div class="mt16" attrs="{'invisible': [('embat_data_id', '=', False)]}">
                                    <button name="load_accounts" type="object" string="Load Accounts" class="btn-secondary" icon="fa-refresh" title="Load accounts to Embat"/>
                                    <button name="load_analytic_accounts" type="object" string="Load Analytics Accounts" class="btn-secondary" icon="fa-refresh" title="Load analytics accounts to Embat"/>
                                    <button name="load_pending_invoices" type="object" string="Load Pending Invoices" class="btn-secondary" icon="fa-refresh" title="Load pending invoices to Embat"/>
                                </div>
                            </div>
                        </div>
                    </div>
                </div>
            </xpath>
        </field>
    </record>
</odoo>
