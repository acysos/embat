<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_partner_form_embat_logs" model="ir.ui.view">
        <field name="name">res.partner.form.embat.logs</field>
        <field name="model">res.partner</field>
        <field name="inherit_id" ref="base.view_partner_form"/>
        <field name="arch" type="xml">
            <notebook position="inside">
                <page string="Embat API Logs" groups="base.group_no_one">
                    <field name="embat_api_log_ids" readonly="1">
                        <list>
                            <field name="create_date"/>
                            <field name="request_type"/>
                            <field name="name"/>
                            <field name="response"/>
                        </list>
                    </field>
                </page>
            </notebook>
        </field>
    </record>
</odoo>
