        <!-- Embat API Configuration Parameters -->
        <record id="embat_api_url_test" model="ir.config_parameter">
            <field name="key">embat.api_url.test</field>
            <field name="value">https://api-embat-fw3hjuy3oa-ey.a.run.app/</field>
        </record>

        <record id="embat_api_url_production" model="ir.config_parameter">
            <field name="key">embat.api_url.production</field>
            <field name="value">https://api.embat.io</field>
