<odoo>
    <record id="ir_cron_reconcile_payments_embat" model="ir.cron">
        <field name="name">Reconcile payments Embat (cada 15 minutos)</field>
        <field name="model_id" ref="model_embat_data"/>
        <field name="state">code</field>
        <field name="code">model.reconcile_payments_embat()</field>
        <field name="interval_number">15</field>
        <field name="interval_type">minutes</field>

